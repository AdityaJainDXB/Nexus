<Window x:Class="Nexus.App.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Nexus" Width="760" Height="600" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Icon="pack://application:,,,/Assets/nexus.ico" UseLayoutRounding="True">
    <DockPanel Margin="34,28">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button x:Name="Next" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Continue" Click="Next_Click" Padding="22,8"/>
            <Button x:Name="Back" DockPanel.Dock="Right" Content="Back" Click="Back_Click" Margin="0,0,8,0" Visibility="Hidden"/>
            <Button Style="{StaticResource Ghost}" Content="Skip setup" Click="Skip_Click" HorizontalAlignment="Left" Foreground="{DynamicResource TextMuted}"/>
        </DockPanel>
        <TextBlock x:Name="StepLabel" DockPanel.Dock="Top" Style="{StaticResource Eyebrow}"/>
        <ContentControl x:Name="Step" Margin="0,8,0,0"/>
    </DockPanel>
</Window>
