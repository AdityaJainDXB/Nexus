<UserControl x:Class="Nexus.App.InsightsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="INSIGHTS // THINGS WORTH A MINUTE" Style="{StaticResource Eyebrow}"/>
            <DockPanel Margin="0,4,0,14">
                <Button DockPanel.Dock="Right" Content="Scan now" Click="Scan_Click" VerticalAlignment="Center"/>
                <TextBlock Text="Insights" Style="{StaticResource PageTitle}"/>
            </DockPanel>
        </StackPanel>
        <ListBox Style="{StaticResource Rows}" ItemsSource="{Binding Insights}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="{Binding Severity}" Style="{StaticResource Eyebrow}"/>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14.5" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,3"/>
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="None"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="{Binding FixLabel}" Style="{StaticResource Primary}" Visibility="{Binding HasFix, Converter={StaticResource BoolToVis}}" Click="Fix_Click" Tag="{Binding}" Margin="0,0,0,6" MinWidth="120"/>
                            <Button Content="Dismiss" Style="{StaticResource Ghost}" Click="Dismiss_Click" Tag="{Binding}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
