<UserControl x:Class="Nexus.App.TasksPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="TASKS // BACKGROUND WORK QUEUE" Style="{StaticResource Eyebrow}"/>
                <TextBlock Text="Tasks &amp; Schedule" Style="{StaticResource PageTitle}" Margin="0,4,0,14"/>
            </StackPanel>
            <ListBox Style="{StaticResource Rows}" ItemsSource="{Binding Jobs}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Retry" Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}" Click="Retry_Click" Tag="{Binding}" VerticalAlignment="Center"/>
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Style="{StaticResource Mono}" Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="None"/>
                                <TextBlock Text="{Binding When}" Style="{StaticResource Mono}" Foreground="{DynamicResource TextFaint}" FontSize="11"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        <StackPanel Grid.Column="2">
            <TextBlock Text="SCHEDULE A COMMAND" Style="{StaticResource Section}" Margin="2,52,0,8"/>
            <Border Style="{StaticResource Card}" Padding="8">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Add" Click="Add_Click" Margin="8,0,0,0"/>
                    <TextBox x:Name="Sched" BorderThickness="0" Background="Transparent"/>
                </DockPanel>
            </Border>
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,6,0,0" Text="e.g. “organize Downloads every night at 10pm”, “generate weekly report every Sunday at 9am”, “clean up duplicates tomorrow at 8am”"/>
            <TextBlock Text="COMING UP" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <ItemsControl ItemsSource="{Binding Upcoming}">
                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,4" Style="{StaticResource Mono}" TextWrapping="Wrap" TextTrimming="None"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
