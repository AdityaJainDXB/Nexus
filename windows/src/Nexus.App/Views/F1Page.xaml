<UserControl x:Class="Nexus.App.F1Page" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="Updated" Style="{StaticResource Mono}" Foreground="{DynamicResource TextFaint}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="Refresh" Click="Refresh_Click"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="FORMULA 1 // LIVE TIMING" Style="{StaticResource Eyebrow}"/>
                    <TextBlock x:Name="Title" Text="Formula 1" Style="{StaticResource PageTitle}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
            <WrapPanel Margin="0,10,0,12">
                <Border x:Name="StatusChip" Style="{StaticResource Pill}" Padding="10,3"><TextBlock x:Name="StatusText" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="SemiBold"/></Border>
                <TextBlock x:Name="Subtitle" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="4,0,0,0"/>
            </WrapPanel>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>

            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,8" Margin="0,0,0,8" x:Name="HeaderRow">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="P" Style="{StaticResource Section}" Margin="0"/>
                        <TextBlock Grid.Column="1" Text="DRIVER" Style="{StaticResource Section}" Margin="0"/>
                        <TextBlock Grid.Column="2" Text="GAP" Style="{StaticResource Section}" Margin="0"/>
                        <TextBlock Grid.Column="3" Text="INTERVAL" Style="{StaticResource Section}" Margin="0"/>
                        <TextBlock Grid.Column="4" Text="LAST" Style="{StaticResource Section}" Margin="0"/>
                        <TextBlock Grid.Column="5" Text="BEST" Style="{StaticResource Section}" Margin="0"/>
                        <TextBlock Grid.Column="6" Text="TYRE" Style="{StaticResource Section}" Margin="0"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="Empty" Style="{StaticResource Muted}" TextWrapping="Wrap" Visibility="Collapsed"
                           Text="No session on track right now. The timing board fills in automatically when practice, qualifying or the race starts."/>
                <ListBox x:Name="Board" Style="{StaticResource Rows}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Position}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Border Width="3" CornerRadius="2" Background="{Binding TeamBrush}" Margin="0,1,10,1"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Team}" Style="{StaticResource Muted}" FontSize="11.5"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Gap}" Style="{StaticResource Mono}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding Interval}" Style="{StaticResource Mono}" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock Grid.Column="4" Text="{Binding Last}" Style="{StaticResource Mono}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="{Binding Best}" Style="{StaticResource Mono}" VerticalAlignment="Center" Foreground="{DynamicResource Violet}"/>
                                <TextBlock Grid.Column="6" Text="{Binding Tyre}" Style="{StaticResource Mono}" VerticalAlignment="Center" Foreground="{Binding TyreBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" x:Name="NextCard">
                        <StackPanel>
                            <TextBlock Text="NEXT UP" Style="{StaticResource Section}" Margin="0,0,0,6"/>
                            <TextBlock x:Name="NextName" FontWeight="SemiBold" FontSize="14.5" TextWrapping="Wrap" TextTrimming="None"/>
                            <TextBlock x:Name="NextWhen" Style="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0"/>
                            <TextBlock x:Name="Countdown" FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,8,0,0"/>
                            <ItemsControl x:Name="Sessions" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Mono}" FontSize="11.5" Margin="0,2" Foreground="{DynamicResource TextMuted}"/></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="RACE CONTROL" Style="{StaticResource Section}"/>
                    <Border Style="{StaticResource Card}" Padding="12,8">
                        <ItemsControl x:Name="Control">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Style="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource TextFaint}" Width="44"/>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" TextTrimming="None" FontSize="12" Foreground="{Binding Brush}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <DockPanel>
                        <Button DockPanel.Dock="Right" x:Name="StandingsToggle" Style="{StaticResource Ghost}" Content="Teams →" Click="ToggleStandings_Click" Foreground="{DynamicResource Accent}" VerticalAlignment="Bottom"/>
                        <TextBlock x:Name="StandingsTitle" Text="DRIVERS' CHAMPIONSHIP" Style="{StaticResource Section}"/>
                    </DockPanel>
                    <Border Style="{StaticResource Card}" Padding="12,8">
                        <ItemsControl x:Name="Standings">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Position}" Style="{StaticResource Mono}" Width="26" Foreground="{DynamicResource TextFaint}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Points}" Style="{StaticResource Mono}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <TextBlock x:Name="Source" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="2,10,0,16"
                               Text="Live timing from the public OpenF1 feed; schedule and standings from the Jolpica/Ergast mirror. Unofficial — not affiliated with Formula 1."/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
