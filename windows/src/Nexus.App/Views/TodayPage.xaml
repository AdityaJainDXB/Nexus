<UserControl x:Class="Nexus.App.TodayPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock x:Name="Eyebrow" Style="{StaticResource Eyebrow}"/>
            <TextBlock x:Name="Greeting" Style="{StaticResource PageTitle}" Margin="0,4,0,14"/>

            <Border Style="{StaticResource Card}" Padding="8" Background="{DynamicResource BgElevated}" BorderBrush="{DynamicResource LineStrong}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Run" Click="Run_Click" Margin="8,0,0,0" Padding="18,8"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="🎙" FontSize="15" Click="Mic_Click" ToolTip="Talk to Nexus" AutomationProperties.Name="Talk to Nexus"/>
                    <TextBox x:Name="Command" BorderThickness="0" Background="Transparent" FontSize="15" KeyDown="Command_KeyDown" AutomationProperties.Name="Command"/>
                </DockPanel>
            </Border>
            <TextBlock Style="{StaticResource Muted}" Margin="4,6,0,0" FontSize="11.5" Text="Try: organize Downloads · clean up duplicates · find invoices from last month · when is the invoice due? · every Sunday at 9am generate weekly report"/>

            <UniformGrid Columns="4" Margin="-6,18,-6,0">
                <Border Style="{StaticResource Card}" Margin="6"><StackPanel><TextBlock Text="FILES UNDERSTOOD" Style="{StaticResource Section}" Margin="0"/><TextBlock Text="{Binding FileCount}" Style="{StaticResource BigNumber}" Margin="0,6,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="6"><StackPanel><TextBlock Text="FILED TODAY" Style="{StaticResource Section}" Margin="0"/><TextBlock Text="{Binding FiledToday}" Style="{StaticResource BigNumber}" Foreground="{DynamicResource Good}" Margin="0,6,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="6"><StackPanel><TextBlock Text="WAITING FOR YOU" Style="{StaticResource Section}" Margin="0"/><TextBlock Text="{Binding ReviewCount}" Style="{StaticResource BigNumber}" Foreground="{DynamicResource Warn}" Margin="0,6,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="6"><StackPanel><TextBlock Text="ACTIVE RULES" Style="{StaticResource Section}" Margin="0"/><TextBlock Text="{Binding RulesCount}" Style="{StaticResource BigNumber}" Foreground="{DynamicResource Accent}" Margin="0,6,0,0"/></StackPanel></Border>
            </UniformGrid>

            <WrapPanel Margin="0,10,0,0">
                <Button Content="✦  Organize Downloads" Tag="organize Downloads" Click="Quick_Click" Margin="0,0,8,8"/>
                <Button Content="⧉  Clean up duplicates" Tag="clean up duplicates" Click="Quick_Click" Margin="0,0,8,8"/>
                <Button Content="☀  Brief me" Tag="brief me" Click="Quick_Click" Margin="0,0,8,8"/>
                <Button Content="▤  Weekly report" Tag="generate weekly report" Click="Quick_Click" Margin="0,0,8,8"/>
                <Button Content="⟳  Learn my folders" Tag="learn my folders" Click="Quick_Click" Margin="0,0,8,8"/>
            </WrapPanel>

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel>
                    <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Open queue →" Click="OpenReview_Click" Foreground="{DynamicResource Accent}"/><TextBlock Text="NEEDS YOUR OK" Style="{StaticResource Section}"/></DockPanel>
                    <TextBlock x:Name="NoReview" Style="{StaticResource Muted}" Text="Nothing waiting. New downloads are filed automatically when Nexus is confident." TextWrapping="Wrap" Margin="2,0,0,0"/>
                    <ItemsControl x:Name="ReviewList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,8">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Approve" Style="{StaticResource Primary}" Padding="10,5" Click="Approve_Click" Tag="{Binding}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Style="{StaticResource Muted}"><Run Text="→ "/><Run Text="{Binding Destination, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Confidence, Mode=OneWay}" Foreground="{DynamicResource Accent}"/></TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="INSIGHTS" Style="{StaticResource Section}"/>
                    <TextBlock x:Name="NoInsights" Style="{StaticResource Muted}" Text="No insights yet — Nexus scans your folders every few hours." TextWrapping="Wrap" Margin="2,0,0,0"/>
                    <ItemsControl x:Name="InsightList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,8">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="{Binding FixLabel}" Visibility="{Binding HasFix, Converter={StaticResource BoolToVis}}" Click="Fix_Click" Tag="{Binding}" Padding="10,5" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="None"/>
                                            <TextBlock Text="{Binding Severity}" Style="{StaticResource Eyebrow}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <TextBlock Text="RECENT ACTIVITY" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}" Padding="14,8">
                <ItemsControl x:Name="EventList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,5" Opacity="{Binding Opacity}">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Style="{StaticResource Mono}" Foreground="{DynamicResource TextFaint}" Width="92"/>
                                <TextBlock Text="{Binding Message}"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
