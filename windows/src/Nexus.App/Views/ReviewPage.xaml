<UserControl x:Class="Nexus.App.ReviewPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="REVIEW // SUGGESTIONS WAITING FOR YOU" Style="{StaticResource Eyebrow}"/>
            <DockPanel Margin="0,4,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Approve all" Style="{StaticResource Primary}" Click="ApproveAll_Click" Margin="0,0,8,0"/>
                    <Button Content="Reject all" Click="RejectAll_Click"/>
                </StackPanel>
                <TextBlock Text="Review Queue" Style="{StaticResource PageTitle}"/>
            </DockPanel>
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,14" TextWrapping="Wrap" Text="Approving moves the file right away and teaches Nexus your structure. Enter approves · Shift+Enter rejects · pick another folder from the list to redirect."/>
        </StackPanel>
        <Grid>
            <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="✓" FontSize="44" HorizontalAlignment="Center" Foreground="{DynamicResource Good}"/>
                <TextBlock Text="All caught up" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,4"/>
                <TextBlock Style="{StaticResource Muted}" Text="Medium-confidence suggestions land here. Confident ones are filed automatically." HorizontalAlignment="Center"/>
            </StackPanel>
            <ListBox x:Name="List" Style="{StaticResource Rows}" ItemsSource="{Binding Reviews}" KeyDown="List_KeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Pill}"><TextBlock Text="{Binding Confidence}" Foreground="{DynamicResource Accent}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"/></Border>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14.5"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0"><Run Text="{Binding From, Mode=OneWay}"/><Run Text="   →   " Foreground="{DynamicResource Accent}"/><Run Text="{Binding Destination, Mode=OneWay}" Foreground="{DynamicResource Text}"/></TextBlock>
                                <TextBlock Text="{Binding Reason}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None"/>
                                <TextBlock Text="{Binding Tags}" Foreground="{DynamicResource Violet}" FontSize="12" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Width="190">
                                <Button Content="Approve" Style="{StaticResource Primary}" Click="Approve_Click" Tag="{Binding}" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding Alternatives}" Tag="{Binding}" SelectionChanged="Alt_Changed" Margin="0,0,0,6" ToolTip="File somewhere else"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Show" Style="{StaticResource Ghost}" Click="Reveal_Click" Tag="{Binding}"/>
                                    <Button Content="Reject" Click="Reject_Click" Tag="{Binding}"/>
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</UserControl>
