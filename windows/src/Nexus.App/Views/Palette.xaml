<Window x:Class="Nexus.App.Palette"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ask Nexus" Width="700" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual" UseLayoutRounding="True">
    <Border Background="{DynamicResource BgElevated}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="14" Margin="18">
        <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.45"/></Border.Effect>
        <StackPanel>
            <DockPanel Margin="16,12,12,12">
                <Button x:Name="Mic" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Click="Mic_Click" FontSize="17" ToolTip="Talk to Nexus" AutomationProperties.Name="Talk to Nexus">
                    <TextBlock x:Name="MicGlyph" Text="🎙"/>
                </Button>
                <TextBlock DockPanel.Dock="Left" Text="⌕" FontSize="20" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="Input" BorderThickness="0" Background="Transparent" FontSize="18" Padding="0,6" PreviewKeyDown="Input_KeyDown" TextChanged="Input_TextChanged" AutomationProperties.Name="Ask Nexus"/>
            </DockPanel>
            <Border x:Name="ContextChip" Style="{StaticResource Pill}" HorizontalAlignment="Left" Margin="46,-6,0,8" Visibility="Collapsed">
                <TextBlock x:Name="ContextText" FontSize="11.5" Foreground="{DynamicResource Accent}"/>
            </Border>
            <Border x:Name="Body" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Visibility="Collapsed">
                <StackPanel Margin="18,12,18,6">
                    <TextBlock x:Name="VoiceLine" Foreground="{DynamicResource Violet}" FontFamily="{StaticResource MonoFont}" FontSize="12" Visibility="Collapsed" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="Steps">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock><Run Text="{Binding Label, Mode=OneWay}" Foreground="{DynamicResource Accent}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"/><Run Text="   "/><Run Text="{Binding Note, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                                    <ItemsControl ItemsSource="{Binding Preview}" Margin="14,4,0,0">
                                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Muted}" Margin="0,1"/></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="Result" TextWrapping="Wrap" TextTrimming="None" FontSize="14" Margin="0,0,0,8" Visibility="Collapsed"/>
                    <ItemsControl x:Name="Suggestions">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Click="Suggestion_Click" Foreground="{DynamicResource TextMuted}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="18,8">
                <DockPanel>
                    <Button x:Name="RunBtn" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Run it" Click="Run_Click" Visibility="Collapsed" Padding="16,5"/>
                    <TextBlock x:Name="Hints" Style="{StaticResource Mono}" Foreground="{DynamicResource TextFaint}" FontSize="11" VerticalAlignment="Center"
                               Text="↵ preview · Ctrl+↵ run · ↑ history · Esc close"/>
                </DockPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
