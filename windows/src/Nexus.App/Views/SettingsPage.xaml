<UserControl x:Class="Nexus.App.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Body" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="SETTINGS" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" Margin="0,4,0,6"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
