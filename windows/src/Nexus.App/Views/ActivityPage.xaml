<UserControl x:Class="Nexus.App.ActivityPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="ACTIVITY // EVERYTHING NEXUS DID, UNDOABLE" Style="{StaticResource Eyebrow}"/>
            <DockPanel Margin="0,4,0,14">
                <Button DockPanel.Dock="Right" Content="↶  Undo last" Style="{StaticResource Primary}" Click="Undo_Click" VerticalAlignment="Center"/>
                <TextBlock Text="Activity" Style="{StaticResource PageTitle}"/>
            </DockPanel>
        </StackPanel>
        <Border Style="{StaticResource Card}" Padding="6">
            <ListBox ItemsSource="{Binding Events}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/></Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Opacity="{Binding Opacity}">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Style="{StaticResource Mono}" Foreground="{DynamicResource TextFaint}" Width="100"/>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Kind}" Style="{StaticResource Mono}" Foreground="{DynamicResource Accent}" Width="110"/>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" TextTrimming="None"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</UserControl>
