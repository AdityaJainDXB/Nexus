<UserControl x:Class="Nexus.App.RulesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="RULES // AUTOMATIONS IN PLAIN ENGLISH" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Rules &amp; Automations" Style="{StaticResource PageTitle}" Margin="0,4,0,14"/>
            <Border Style="{StaticResource Card}" Padding="8" Background="{DynamicResource BgElevated}" BorderBrush="{DynamicResource LineStrong}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Create rule" Click="Create_Click" Margin="8,0,0,0" x:Name="CreateBtn" IsEnabled="False"/>
                    <Button DockPanel.Dock="Right" Content="Preview" Click="Preview_Click" Margin="8,0,0,0"/>
                    <TextBox x:Name="Sentence" BorderThickness="0" Background="Transparent" TextChanged="Sentence_Changed" KeyDown="Sentence_KeyDown" AutomationProperties.Name="Describe a rule"/>
                </DockPanel>
            </Border>
            <WrapPanel Margin="0,8,0,0" x:Name="Examples"/>
            <Border x:Name="PreviewBox" Style="{StaticResource Card}" Margin="0,10,0,0" Visibility="Collapsed" BorderBrush="{DynamicResource Accent}">
                <StackPanel>
                    <TextBlock x:Name="PreviewName" FontWeight="SemiBold" FontSize="14.5" TextWrapping="Wrap" TextTrimming="None"/>
                    <ItemsControl x:Name="PreviewLines" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Conflicts}" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=⚠  {0}}" Foreground="{DynamicResource Warn}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="YOUR RULES" Style="{StaticResource Section}"/>
        </StackPanel>
        <ListBox Style="{StaticResource Rows}" ItemsSource="{Binding Rules}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding Hits}" Style="{StaticResource Mono}" Foreground="{DynamicResource TextFaint}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" Margin="0,0,12,0" AutomationProperties.Name="Enabled"/>
                            <Button Content="Run now" Click="Run_Click" Tag="{Binding}" Margin="0,0,6,0"/>
                            <Button Content="Test…" Click="Test_Click" Tag="{Binding}" Margin="0,0,6,0"/>
                            <Button Content="Delete" Style="{StaticResource Danger}" Click="Delete_Click" Tag="{Binding}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
